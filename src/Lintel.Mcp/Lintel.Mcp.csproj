<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Lintel.Mcp</RootNamespace>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lintel-mcp</ToolCommandName>
    <PackageId>Lintel.Mcp</PackageId>
    <Description>MCP server for Lintel, a language for information requirements on IFC models that compiles to buildingSMART IDS. It gives an AI agent the language guide, the names of the IFC schema, a checker and the IDS compiler.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lintel\Lintel.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <!-- The one-page description of the language is the answer of the guide tool: one text, kept in one place. -->
    <EmbeddedResource Include="..\..\LLM.md" LogicalName="Lintel.Mcp.LLM.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Lintel.Mcp.Tests" />
  </ItemGroup>
</Project>
